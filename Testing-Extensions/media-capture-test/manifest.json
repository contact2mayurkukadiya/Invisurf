{
  "manifest_version": 3,
  "name": "Media Capture Tester",
  "version": "1.0.0",
  "description": "Test chrome.tabCapture and chrome.desktopCapture APIs with live preview and track diagnostics in InviSurf.",
  "permissions": [
    "tabCapture",
    "desktopCapture",
    "tabs",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Media Capture Tester"
  },
  "icons": {
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
